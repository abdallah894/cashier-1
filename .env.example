# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New dashboards call this the "publishable key" (sb_publishable_…);
# NEXT_PUBLIC_SUPABASE_ANON_KEY also works as a fallback name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — NEVER expose with NEXT_PUBLIC_. Used by scripts/seed.ts
# to create auth users. Keep out of git (.env.local is gitignored).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passwords the seed script assigns to the demo users
SEED_ADMIN_EMAIL=admin@cachier.local
SEED_ADMIN_PASSWORD=123456
SEED_CASHIER_EMAIL=cashier@cachier.local
SEED_CASHIER_PASSWORD=123456
GEMINI_API_KEY=
# Server-only key for the Groq-backed chat route.
GROQ_API_KEY=

# Payments (see docs/payments.md). Server-only. The sandbox provider's
# callback route /api/payments/webhook/sandbox rejects everything (503)
# until this secret is set; callbacks must carry x-signature = HMAC-SHA256
# (hex) of the raw body using this secret. Never expose it with NEXT_PUBLIC_.
PAYMENT_SANDBOX_WEBHOOK_SECRET=

# AI assistant (server-only). Providers are tried in this order; a failing one
# is skipped by a circuit breaker. Leave a key empty to disable that provider.
AI_PROVIDER_ORDER=groq,gemini
GROQ_MODEL=
GEMINI_MODELS=

# Operations (see docs/operations/). Server-only.
# Bearer token for /api/ops/* and /api/health?deep=1 and backup reports.
OPS_API_TOKEN=
# Vercel Cron sends this as the Authorization bearer for /api/ops/check.
CRON_SECRET=
# Backups (scripts/backup-db.sh runs on a scheduler machine, NOT in Vercel; see
# docs/operations/runbook.md). Shown here so nobody forgets them:
#   SUPABASE_DB_URL, APP_URL, OPS_API_TOKEN, BACKUP_AGE_RECIPIENT (or BACKUP_GPG_RECIPIENT),
#   BACKUP_UPLOAD_CMD (e.g. 'rclone copyto "$1" remote:pos-backups/$(basename "$1")')

# Tax-authority e-receipts (docs/eta.md). Leave ETA_PROVIDER empty until a real
# provider is installed: queued receipts then wait and the eta_backlog alert fires.
ETA_PROVIDER=

# Optional webhooks (Slack/Teams/any JSON receiver) for alerts and errors.
ALERT_WEBHOOK_URL=
ERROR_WEBHOOK_URL=
